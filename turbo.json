{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["**/.env.*local", "**/.env.local", "**/package.json"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_NODE_ENV"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_NODE_ENV"]
    },
    "lint": {
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_NODE_ENV"]
    },
    "typecheck": {
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_NODE_ENV"]
    },
    "test": {
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_NODE_ENV"]
    },
    "test:e2e": {
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_NODE_ENV"]
    }
  }
}
