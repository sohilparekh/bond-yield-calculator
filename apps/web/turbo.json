{
    "extends": [
        "//"
    ],
    "tasks": {
        "build": {
            "dependsOn": [
                "@repo/api#build",
                "@repo/ui#build",
                "^build"
            ],
            "outputs": [
                ".next/**",
                "!.next/cache/**",
                "!.next/static/**"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                ".env.local"
            ],
            "env": [
                "NEXT_PUBLIC_API_URL",
                "NEXT_PUBLIC_NODE_ENV"
            ]
        },
        "dev": {
            "cache": false,
            "persistent": true,
            "dependsOn": [
                "^build"
            ]
        },
        "lint": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "coverage/**"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "jest.config.js",
                "jest.setup.js"
            ]
        },
        "test:coverage": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "coverage/**"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "jest.config.js",
                "jest.setup.js"
            ]
        },
        "test:watch": {
            "cache": false,
            "persistent": true,
            "dependsOn": [
                "^build"
            ]
        },
        "start": {
            "dependsOn": [
                "build"
            ],
            "cache": false,
            "persistent": true
        }
    }
}
