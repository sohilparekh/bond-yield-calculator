{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.{ts,tsx,js,jsx}"]
    },
    "typecheck": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.{ts,tsx}"]
    }
  }
}
