{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "build:styles", "build:components"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*"]
    },
    "build:styles": {
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.css", "src/**/*.scss", "tailwind.config.*"]
    },
    "build:components": {
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.{ts,tsx,js,jsx}"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "with": ["dev:styles", "dev:components"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.{ts,tsx,js,jsx}"]
    },
    "typecheck": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "src/**/*.{ts,tsx}"]
    }
  }
}
